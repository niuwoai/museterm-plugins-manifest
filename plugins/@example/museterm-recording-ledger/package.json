{
  "name": "@example/museterm-recording-ledger",
  "version": "0.1.0",
  "description": "Remember the metadata of the last saved recording and show it from the palette.",
  "license": "LicenseRef-MuseTerm-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niuwoai/museterm-plugin-recording-ledger.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "museterm": {
    "schemaVersion": 1,
    "engines": {
      "museterm": ">=1.263.0-rc1"
    },
    "entry": "dist/index.js",
    "displayName": {
      "en": "Recording ledger",
      "zh-Hans": "录制台账"
    },
    "permissions": ["palette", "recording.observe"],
    "commands": [
      {
        "id": "latest",
        "title": {
          "en": "Latest recording",
          "zh-Hans": "最近一条录制"
        },
        "subtitle": {
          "en": "Title and event count only",
          "zh-Hans": "只有标题和事件数"
        },
        "symbol": "book.closed",
        "priority": 10,
        "export": "latestRecording"
      }
    ],
    "recording": {
      "onFinished": "onRecording"
    }
  }
}
